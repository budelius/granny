# Granny — example environment file.
# Copy to `.env` and fill in the values you need. All variables are optional;
# set only the ones required by the commands you run.
#
#   cp .env.example .env
#
# `.env` and `.deploy.env` are auto-loaded by the CLI via python-dotenv.

# --- Bunny CDN ---------------------------------------------------------------
# Default Bunny API key:
BUNNY_API_KEY=

# Per-customer keys (optional). Suffix is the upper-cased, underscore-joined
# slug of the customer name. e.g. customer "acme" -> BUNNY_API_KEY_ACME.
#BUNNY_API_KEY_ACME=
#BUNNY_API_KEY_EXAMPLE_CO=

# Comma-separated registry of known customer slugs (used by
# `granny.credentials.list_bunny_customers`). Optional.
#GRANNY_BUNNY_CUSTOMERS=acme,example-co

# --- Cloudflare --------------------------------------------------------------
CLOUDFLARE_API_TOKEN=

# --- deSEC DNS ---------------------------------------------------------------
DESEC_API_TOKEN=

# --- Hetzner -----------------------------------------------------------------
HETZNER_S3_ACCESS_KEY=
HETZNER_S3_SECRET_KEY=
HETZNER_DNS_API_TOKEN=

# --- Scaleway ----------------------------------------------------------------
SCW_ACCESS_KEY=
SCW_SECRET_KEY=
SCW_DEFAULT_PROJECT_ID=

# --- Mailjet -----------------------------------------------------------------
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# --- ClouDNS -----------------------------------------------------------------
CLOUDNS_AUTH_ID=
CLOUDNS_AUTH_PASSWORD=
CLOUDNS_SUB_AUTH_ID=
CLOUDNS_SUB_AUTH_USER=

# --- INWX (api.domrobot.com) -------------------------------------------------
INWX_USERNAME=
INWX_PASSWORD=
# Base32 TOTP shared secret. Only set this if 2FA (Google Authenticator) is
# enabled on the INWX account; otherwise leave blank.
INWX_SHARED_SECRET=

# --- Docker Hub (used by `granny docker build-base --login-docker-hub`) ------
DOCKER_HUB_USER=
DOCKER_HUB_TOKEN=

# --- GitLab PyPI / Container Registry ----------------------------------------
GITLAB_PYPI_USER=
GITLAB_PYPI_PASSWORD=
