# Granny -- example environment file.
#
# This file is for the small set of secrets that make sense to keep in a
# dotenv file -- short-lived API tokens, single-account provider keys you
# rotate often, or values you want to override per-checkout. The primary
# credential store is the Vaultwarden vault (resolved via Locke); secrets
# that live there don't need to be repeated here.
#
# Copy and fill in only the values you actually need:
#
#   cp .env.example .env
#
# `.env` and `.deploy.env` are auto-loaded by the CLI via python-dotenv.
# Run `granny credentials status` to confirm what's reachable from vault
# vs. env.

# --- Bunny CDN ---------------------------------------------------------------
# Default Bunny API key:
BUNNY_API_KEY=

# Per-customer keys (optional). Suffix is the upper-cased, underscore-joined
# slug of the customer name. e.g. customer "acme" -> BUNNY_API_KEY_ACME.
#BUNNY_API_KEY_ACME=
#BUNNY_API_KEY_EXAMPLE_CO=

# Comma-separated registry of known customer slugs (used by
# `granny.credentials.list_bunny_customers`). Optional.
#GRANNY_BUNNY_CUSTOMERS=acme,example-co

# --- Cloudflare --------------------------------------------------------------
CLOUDFLARE_API_TOKEN=

# --- deSEC DNS ---------------------------------------------------------------
DESEC_API_TOKEN=

# --- Hetzner -----------------------------------------------------------------
HETZNER_S3_ACCESS_KEY=
HETZNER_S3_SECRET_KEY=
HETZNER_DNS_API_TOKEN=

# --- Scaleway ----------------------------------------------------------------
SCW_ACCESS_KEY=
SCW_SECRET_KEY=
SCW_DEFAULT_PROJECT_ID=

# --- Mailjet -----------------------------------------------------------------
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# --- ClouDNS -----------------------------------------------------------------
CLOUDNS_AUTH_ID=
CLOUDNS_AUTH_PASSWORD=
CLOUDNS_SUB_AUTH_ID=
CLOUDNS_SUB_AUTH_USER=

# Note: registry / CI / 2FA-style secrets (INWX_*, DOCKER_HUB_*,
# GITLAB_PYPI_*, etc.) intentionally do not appear here. They live in the
# Vaultwarden vault and are resolved via Locke at runtime. Run
# `granny credentials status` to see what's currently reachable.
